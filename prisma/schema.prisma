generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { ADMIN CASHIER VIEWER }
enum ProductType { DIRECT_INVENTORY COMPONENT_BASED NON_INVENTORY }
enum OrderStatus { DRAFT PENDING COMPLETED CANCELLED VOIDED }
enum PaymentMethod { CASH ONLINE }
model User { id String @id @default(cuid()) authId String @unique name String email String @unique role Role @default(CASHIER) active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt orders Order[] auditLogs AuditLog[] }
model BusinessSetting { id String @id @default(cuid()) name String @default("MARK'S ICE IT UP") logoPath String? address String? contact String? currency String @default("PHP") timezone String @default("Asia/Manila") orderPrefix String @default("IIU") lowStockDefault Decimal @default(0) updatedAt DateTime @updatedAt }
model Product { id String @id @default(cuid()) name String description String? type ProductType basePrice Decimal availability Boolean @default(true) archived Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt components ProductComponent[] productAddons ProductAddon[] orderItems OrderItem[] }
model Addon { id String @id @default(cuid()) name String price Decimal @default(0) availability Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt productLinks ProductAddon[] orderItemAddons OrderItemAddon[] components AddonComponent[] }
model InventoryItem { id String @id @default(cuid()) name String category String? quantity Decimal @default(0) unit String minStock Decimal @default(0) components ProductComponent[] addonComponents AddonComponent[] movements InventoryMovement[] }
model ProductComponent { id String @id @default(cuid()) productId String inventoryItemId String quantity Decimal product Product @relation(fields:[productId],references:[id]) inventoryItem InventoryItem @relation(fields:[inventoryItemId],references:[id]) @@unique([productId,inventoryItemId]) }
model AddonComponent { id String @id @default(cuid()) addonId String inventoryItemId String quantity Decimal addon Addon @relation(fields:[addonId],references:[id]) inventoryItem InventoryItem @relation(fields:[inventoryItemId],references:[id]) @@unique([addonId,inventoryItemId]) }
model ProductAddon { id String @id @default(cuid()) productId String addonId String product Product @relation(fields:[productId],references:[id]) addon Addon @relation(fields:[addonId],references:[id]) @@unique([productId,addonId]) }
model Customer { id String @id @default(cuid()) name String contact String? createdAt DateTime @default(now()) orders Order[] }
model Order { id String @id @default(cuid()) code String @unique status OrderStatus @default(DRAFT) customerId String? userId String subtotal Decimal @default(0) discountAmount Decimal @default(0) total Decimal @default(0) createdAt DateTime @default(now()) completedAt DateTime? customer Customer? @relation(fields:[customerId],references:[id]) user User @relation(fields:[userId],references:[id]) items OrderItem[] payment Payment? movements InventoryMovement[] }
model OrderItem { id String @id @default(cuid()) orderId String productId String? productName String productPrice Decimal quantity Int total Decimal order Order @relation(fields:[orderId],references:[id]) product Product? @relation(fields:[productId],references:[id]) addons OrderItemAddon[] }
model OrderItemAddon { id String @id @default(cuid()) orderItemId String addonId String? addonName String addonPrice Decimal orderItem OrderItem @relation(fields:[orderItemId],references:[id]) addon Addon? @relation(fields:[addonId],references:[id]) }
model Payment { id String @id @default(cuid()) orderId String @unique method PaymentMethod amount Decimal received Decimal? change Decimal? proofPath String? createdAt DateTime @default(now()) order Order @relation(fields:[orderId],references:[id]) }
model InventoryMovement { id String @id @default(cuid()) inventoryItemId String orderId String? beforeQty Decimal changeQty Decimal afterQty Decimal type String reason String? userId String? createdAt DateTime @default(now()) inventoryItem InventoryItem @relation(fields:[inventoryItemId],references:[id]) order Order? @relation(fields:[orderId],references:[id]) }
model Expense { id String @id @default(cuid()) date DateTime @default(now()) description String category String amount Decimal supplier String? notes String? userId String createdAt DateTime @default(now()) }
model Purchase { id String @id @default(cuid()) date DateTime @default(now()) description String amount Decimal supplier String? userId String createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String action String entity String entityId String? previous Json? next Json? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) }
