generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { ADMIN CASHIER VIEWER }
enum ProductType { DIRECT_INVENTORY COMPONENT_BASED NON_INVENTORY }
enum OrderStatus { DRAFT PENDING COMPLETED CANCELLED VOIDED }
enum PaymentMethod { CASH ONLINE }
enum DiscountType { FIXED PERCENTAGE }
model User { id String @id @default(cuid()) authUserId String @unique name String email String @unique role Role @default(CASHIER) isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt orders Order[] auditLogs AuditLog[] }
model BusinessSetting { id String @id @default(cuid()) name String @default("MARK'S ICE IT UP") logoPath String? address String? contact String? currency String @default("PHP") timezone String @default("Asia/Manila") orderPrefix String @default("IIU") lowStockDefault Decimal @default(0) receiptFooter String? updatedAt DateTime @updatedAt }
model Product { id String @id @default(cuid()) name String description String? type ProductType price Decimal @db.Decimal(12,2) imagePath String? isActive Boolean @default(true) archived Boolean @default(false) inventoryItemId String? inventoryItem InventoryItem? @relation(fields:[inventoryItemId],references:[id]) components ProductComponent[] productAddons ProductAddon[] orderItems OrderItem[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([isActive,archived]) }
model Addon { id String @id @default(cuid()) name String price Decimal @default(0) @db.Decimal(12,2) imagePath String? isActive Boolean @default(true) components AddonComponent[] productAddons ProductAddon[] orderItemAddons OrderItemAddon[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model InventoryItem { id String @id @default(cuid()) name String category String? quantity Decimal @default(0) @db.Decimal(12,3) unit String minStock Decimal @default(0) @db.Decimal(12,3) components ProductComponent[] addonComponents AddonComponent[] movements InventoryMovement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ProductComponent { id String @id @default(cuid()) productId String inventoryItemId String quantity Decimal @db.Decimal(12,3) product Product @relation(fields:[productId],references:[id],onDelete:Restrict) inventoryItem InventoryItem @relation(fields:[inventoryItemId],references:[id],onDelete:Restrict) @@unique([productId,inventoryItemId]) }
model AddonComponent { id String @id @default(cuid()) addonId String inventoryItemId String quantity Decimal @db.Decimal(12,3) addon Addon @relation(fields:[addonId],references:[id],onDelete:Restrict) inventoryItem InventoryItem @relation(fields:[inventoryItemId],references:[id],onDelete:Restrict) @@unique([addonId,inventoryItemId]) }
model ProductAddon { id String @id @default(cuid()) productId String addonId String product Product @relation(fields:[productId],references:[id],onDelete:Restrict) addon Addon @relation(fields:[addonId],references:[id],onDelete:Restrict) @@unique([productId,addonId]) }
model Customer { id String @id @default(cuid()) name String contact String? orders Order[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Order { id String @id @default(cuid()) code String @unique status OrderStatus @default(DRAFT) customerId String? createdById String subtotal Decimal @default(0) discountType DiscountType? discountValue Decimal @default(0) discountAmount Decimal @default(0) total Decimal @default(0) createdAt DateTime @default(now()) completedAt DateTime? customer Customer? @relation(fields:[customerId],references:[id]) createdBy User @relation(fields:[createdById],references:[id]) items OrderItem[] payment Payment? movements InventoryMovement[] }
model OrderItem { id String @id @default(cuid()) orderId String productId String? nameSnapshot String priceSnapshot Decimal @db.Decimal(12,2) quantity Int itemTotal Decimal @db.Decimal(12,2) order Order @relation(fields:[orderId],references:[id],onDelete:Restrict) product Product? @relation(fields:[productId],references:[id],onDelete:SetNull) addons OrderItemAddon[] }
model OrderItemAddon { id String @id @default(cuid()) orderItemId String addonId String? nameSnapshot String priceSnapshot Decimal @db.Decimal(12,2) orderItem OrderItem @relation(fields:[orderItemId],references:[id],onDelete:Restrict) addon Addon? @relation(fields:[addonId],references:[id],onDelete:SetNull) }
model Payment { id String @id @default(cuid()) orderId String @unique method PaymentMethod amount Decimal @db.Decimal(12,2) amountReceived Decimal @db.Decimal(12,2) changeDue Decimal @db.Decimal(12,2) proofPath String? createdById String createdAt DateTime @default(now()) order Order @relation(fields:[orderId],references:[id],onDelete:Restrict) }
model InventoryMovement { id String @id @default(cuid()) inventoryItemId String orderId String? quantityBefore Decimal @db.Decimal(12,3) quantityChanged Decimal @db.Decimal(12,3) quantityAfter Decimal @db.Decimal(12,3) movementType String reason String? userId String createdAt DateTime @default(now()) inventoryItem InventoryItem @relation(fields:[inventoryItemId],references:[id],onDelete:Restrict) order Order? @relation(fields:[orderId],references:[id],onDelete:SetNull) }
model Expense { id String @id @default(cuid()) date DateTime @default(now()) description String category String amount Decimal @db.Decimal(12,2) supplier String? notes String? userId String createdAt DateTime @default(now()) }
model Purchase { id String @id @default(cuid()) date DateTime @default(now()) description String category String? amount Decimal @db.Decimal(12,2) supplier String? notes String? userId String createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String action String entity String entityId String? previousValue Json? newValue Json? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Restrict) }
